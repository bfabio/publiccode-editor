{
  "git": {
    "commitMessage": "chore: release ${version}"
  },
  "github": {
    "release": true
  },
  "npm": {
    "publish": false,
    "ignoreVersion": true
  },
  "plugins": {
    "@release-it/bumper": {
      "out": [
        "package.json",
        {
          "file": "publiccode.yml",
          "path": "softwareVersion"
        }
      ]
    }
  }
}
